{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "api/**/*.ts",
    "src/server/**/*.ts",
    "src/services/openFoodFacts.ts",
    "src/lib/barcode.ts",
    "src/models/productModel.ts",
    "src/types/browser.d.ts"
  ]
}
