{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [],
    "allowImportingTsExtensions": true,
    "paths": {
      "/assets/barcode-decoder.js": [
        "./src/features/scanner/decoder.ts"
      ],
      "/assets/ingredient-ocr.js": [
        "./src/features/image-recognition/ocr.ts"
      ]
    }
  },
  "include": [
    "admin/**/*.ts",
    "src/**/*.ts"
  ],
  "exclude": [
    "src/app/service-worker.ts",
    "src/server/**/*.ts"
  ]
}
